# Anthropic — pour l'analyse IA
ANTHROPIC_API_KEY=sk-ant-api03-...

# Powens (Open Banking) — https://powens.com/developers
# 1. Créez un compte sur https://developers.powens.com
# 2. Créez une application → récupérez Client ID et Client Secret
# 3. En sandbox : POWENS_DOMAIN=sandbox (accès gratuit, données simulées)
#    En production : POWENS_DOMAIN=votre-domaine-powens
POWENS_DOMAIN=sandbox
POWENS_CLIENT_ID=your_client_id_here
POWENS_CLIENT_SECRET=your_client_secret_here
